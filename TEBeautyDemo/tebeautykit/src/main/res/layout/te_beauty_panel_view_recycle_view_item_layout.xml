<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="90dp"
    android:paddingTop="4dp">

    <com.tencent.effect.beautykit.view.widget.PanelItemSelectorLayout
        android:id="@+id/te_beauty_panel_view_item_left_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="2dp"
        app:corner_radius="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/te_panel_view_item_layout_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="false"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/te_beauty_panel_view_item_edit_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/te_beauty_panel_view_edit_icon_bg"
                android:clickable="false"
                android:padding="11dp"
                android:src="@drawable/te_beauty_panel_edit_icon"
                android:visibility="gone" />

        </FrameLayout>

    </com.tencent.effect.beautykit.view.widget.PanelItemSelectorLayout>


    <com.tencent.effect.beautykit.view.widget.MarqueeTextView
        android:id="@+id/te_panel_view_item_layout_name"
        android:layout_width="56dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:maxWidth="56dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/te_beauty_panel_view_item_left_layout"
        app:mt_speed="70"
        app:mt_textColor="@color/te_beauty_color_99FFFFFF"
        app:mt_textSize="12sp" />


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/te_panel_view_item_layout_point_view"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:background="@drawable/te_beauty_panel_item_bottom_point_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/te_panel_view_item_layout_name"
        app:shapeAppearance="@style/te_beauty_panel_view_item_checked_item_style" />


    <View
        android:id="@+id/te_panel_view_item_layout_right_divider"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:background="@color/te_beauty_color_19FFFFFF"
        android:visibility="gone"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/te_beauty_panel_view_item_left_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>